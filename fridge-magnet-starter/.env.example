# Copy this file to ".env" on your own computer and fill in the values
# below if you ever want to run the app on your own machine (`npm run dev`).
#
# You do NOT need to do this to use the live app — these values are set
# inside Netlify's dashboard instead, under Site settings > Environment
# variables, so they never have to live in this public repository.

VITE_SUPABASE_URL=https://ozvtpylsqtvmagxtetjt.supabase.co
VITE_SUPABASE_ANON_KEY=paste-the-anon-public-key-here

# The VAPID *public* key that lets the browser subscribe to push
# notifications. It's meant to be public — the private half that actually
# authorises sending them lives only in Supabase's Edge Function secrets.
VITE_VAPID_PUBLIC_KEY=paste-the-vapid-public-key-here
